{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blayalems/radar-vital-mmwave-60-davao/blob/main/quality/schemas/required-check-evidence.schema.json",
  "title": "Required Protected Workflow Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_tag",
    "source_sha",
    "generated_at",
    "tag_state",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "rvt-required-check-evidence-v1"
    },
    "release_tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "tag_state": {
      "enum": [
        "new_tag_identity",
        "existing_same_sha_without_release"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_name",
          "workflow_id",
          "path",
          "event",
          "conclusion",
          "run_id",
          "run_attempt",
          "run_url",
          "completed_at"
        ],
        "properties": {
          "workflow_name": {
            "enum": [
              "Playwright tests",
              "Security Audit",
              "Build Android APK (Capacitor)",
              "Build Windows EXE (Tauri)"
            ]
          },
          "workflow_id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "path": {
            "enum": [
              ".github/workflows/playwright.yml",
              ".github/workflows/security-audit.yml",
              ".github/workflows/build-apk.yml",
              ".github/workflows/build-exe.yml"
            ]
          },
          "event": {
            "enum": [
              "push",
              "pull_request"
            ]
          },
          "conclusion": {
            "const": "success"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "run_attempt": {
            "type": "integer",
            "minimum": 1
          },
          "run_url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
          }
        }
      }
    }
  }
}
