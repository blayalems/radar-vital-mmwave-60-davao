{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blayalems/radar-vital-mmwave-60-davao/quality/schemas/document-register.schema.json",
  "title": "Radar Vital controlled document register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "register_id",
    "register_revision",
    "effective_product_version",
    "status",
    "owner_role",
    "approval_method",
    "documents"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "rvt-qms-document-register-v1" },
    "register_id": { "const": "RVT-QMS-REG-001" },
    "register_revision": { "$ref": "#/$defs/revision" },
    "effective_product_version": { "$ref": "#/$defs/semver" },
    "status": { "$ref": "#/$defs/status" },
    "owner_role": { "$ref": "#/$defs/role" },
    "approval_method": { "const": "protected_pull_request" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^R[0-9]{2,}$" },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "superseded", "obsolete"]
    },
    "role": {
      "type": "string",
      "enum": [
        "contributor",
        "technical_lead",
        "quality_manager",
        "research_lead",
        "release_manager",
        "security_owner",
        "firmware_owner",
        "trainer_owner",
        "frontend_owner"
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "title",
        "path",
        "record_type",
        "revision",
        "status",
        "owner_role",
        "approver_roles",
        "effective_product_version",
        "supersedes",
        "retention",
        "confidentiality",
        "review_interval_months"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^RVT-QMS-[A-Z]{3}-[0-9]{3}$"
        },
        "title": { "type": "string", "minLength": 3 },
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(^|/)\\.\\.(/|$)" }
        },
        "record_type": {
          "type": "string",
          "enum": [
            "policy",
            "procedure",
            "register",
            "record",
            "guide",
            "plan",
            "template",
            "configuration",
            "schema"
          ]
        },
        "revision": { "$ref": "#/$defs/revision" },
        "status": { "$ref": "#/$defs/status" },
        "owner_role": { "$ref": "#/$defs/role" },
        "approver_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/role" }
        },
        "effective_product_version": { "$ref": "#/$defs/semver" },
        "supersedes": {
          "type": ["string", "null"],
          "pattern": "^RVT-QMS-[A-Z]{3}-[0-9]{3}$"
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "disposition"],
          "properties": {
            "class": {
              "type": "string",
              "enum": [
                "project_lifetime",
                "project_lifetime_plus_5_years",
                "permanent"
              ]
            },
            "disposition": {
              "type": "string",
              "enum": [
                "retain",
                "review_before_disposal",
                "archive_then_review"
              ]
            }
          }
        },
        "confidentiality": {
          "type": "string",
          "enum": ["public", "internal", "restricted"]
        },
        "review_interval_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    }
  }
}
